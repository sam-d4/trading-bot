# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- OANDA ---
# Create a practice account + generate a personal access token at:
# https://www.oanda.com/demo-account/tpa/personal_token
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live -- this is the ONLY switch between paper and real-money trading.
# Changing this to "live" requires a deliberate edit + service restart, never an in-app toggle.
OANDA_ENVIRONMENT=practice

# --- Instruments ---
PRIMARY_INSTRUMENT=EUR_USD
# Every pair the live engine actually trades, comma-separated - each needs its own trained/
# validated model before it's worth anything beyond the baseline strategy (see
# scripts/run_training.py --instrument <pair>). Historical data must be cached for each one too
# (scripts/fetch_historical_data.py). Pairs listed here that AREN'T being actively traded still
# get streamed for cross-pair context if another traded pair needs them.
TRADED_INSTRUMENTS_CSV=EUR_USD,GBP_USD,USD_JPY,AUD_USD

# --- Risk limits ---
MAX_DAILY_DRAWDOWN_PCT=3.0
MAX_OVERALL_DRAWDOWN_PCT=10.0
# Risk per trade is automatically divided by the number of TRADED_INSTRUMENTS_CSV pairs (see
# app/risk/limits.py), so this is the risk for ONE pair traded alone - adding more pairs spreads
# this same aggregate risk budget across them rather than multiplying it.
RISK_PER_TRADE_PCT=1.0
MAX_LEVERAGE=10.0
FLATTEN_ON_KILL_SWITCH=true

# --- Self-improvement ---
REQUIRE_MANUAL_CONFIRMATION_TO_PROMOTE=true

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASS=

# --- Alerting (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
